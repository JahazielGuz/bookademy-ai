# Anthropic credentials. Leave ANTHROPIC_API_KEY unset if you have run `ant auth login`.
ANTHROPIC_API_KEY=

# Only for an ORGANISATION-level key. A workspace-scoped key does not need this;
# an unscoped key is rejected without it ("not scoped to a workspace").
# Find it in the Console under Settings -> Workspaces (looks like wrkspc_...).
ANTHROPIC_WORKSPACE_ID=

# Shared secret that bookademy-core must send as the X-Service-Token header.
# Any string, as long as it matches bookademy-core/.env exactly.
SERVICE_TOKEN=dev-only-change-me

# Structure is read from the PDF's bookmarks, so the outline model only enriches
# topics and handles PDFs without bookmarks. Content is the bulk of the spend.
OUTLINE_MODEL=claude-sonnet-5-5
CONTENT_MODEL=claude-haiku-4-5
