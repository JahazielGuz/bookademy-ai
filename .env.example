# OpenAI credentials.
OPENAI_API_KEY=

# Shared secret that bookademy-core must send as the X-Service-Token header.
# Any string, as long as it matches bookademy-core/.env exactly.
SERVICE_TOKEN=dev-only-change-me

# Two tiers, because the two calls are not the same kind of work.
#
# OUTLINE_MODEL groups a chapter's own headings into topics. The headings are given,
# so this is constrained work — roughly 15 calls per book, about 8% of the spend.
# OUTLINE_MODEL=gpt-5-mini if the topic grouping ever looks careless.
OUTLINE_MODEL=gpt-5-nano

# CONTENT_MODEL writes every lesson, quiz and exercise: ~165 calls per book and ~92%
# of the spend. This is the product. Dropping it to a nano tier saves roughly a
# dollar a book and is the one change here that would show in what a learner reads.
CONTENT_MODEL=gpt-5-mini

# These models reason before answering, and reasoning tokens are billed as output
# while never appearing in the content you get back. Measured on one small call:
# "low" spent 905 output tokens where "medium" spent 7,961 — 8.8x the cost for 144
# more tokens of answer. Output is ~92% of the bill, so this is the largest single
# dial in this file. Raise CONTENT_REASONING to "medium" if lessons read thin, and
# watch what it does to the cost shown in the library.
OUTLINE_REASONING=low
CONTENT_REASONING=low
