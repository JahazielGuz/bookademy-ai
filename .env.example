# OpenAI credentials.
OPENAI_API_KEY=

# Shared secret that bookademy-core must send as the X-Service-Token header.
# Any string, as long as it matches bookademy-core/.env exactly.
SERVICE_TOKEN=dev-only-change-me

# Structure is read from the PDF's bookmarks, so the outline model only merges a
# chapter's own headings into topics. Content is the bulk of the spend.
# Both mid-tier on purpose: nano-class models are built for classification and
# routing, not for writing exercises where each step has to build on the last.
OUTLINE_MODEL=gpt-5-mini
CONTENT_MODEL=gpt-5-mini
