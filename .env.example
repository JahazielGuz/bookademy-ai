# The model server: llama.cpp's OpenAI-compatible API. Both are required.
# Through ngrok the base URL looks like http://N.tcp.ngrok.io:PORT/v1; the key is the
# one llama.cpp was started with (--api-key).
OPENAI_BASE_URL=
OPENAI_API_KEY=

# Shared secret that bookademy-core must send as the X-Service-Token header.
# Any string, as long as it matches bookademy-core/.env exactly.
SERVICE_TOKEN=dev-only-change-me

# OUTLINE_MODEL groups a chapter's own headings into topics (~15 calls per book).
# CONTENT_MODEL writes every lesson, quiz and exercise (~165 calls, nearly all of the
# time). Both name a model the server has loaded.
OUTLINE_MODEL=qwen3.8-27b
CONTENT_MODEL=qwen3.8-27b

# Whether the model thinks before answering. Thinking costs minutes and context, not
# dollars, and on the content call it ran for ten minutes without starting the
# answer. Off by default; the small calls can afford it if you want to try.
OUTLINE_THINKING=false
CONTENT_THINKING=false

# Context per server slot: llama.cpp's --ctx-size, per --parallel slot. A chapter
# that would not fit beside its answer is cut to fit.
CONTEXT_WINDOW=32768
