# OpenAI credentials.
OPENAI_API_KEY=

# Shared secret that bookademy-core must send as the X-Service-Token header.
# Any string, as long as it matches bookademy-core/.env exactly.
SERVICE_TOKEN=dev-only-change-me

# OUTLINE_MODEL groups a chapter's own headings into topics (~15 calls per book).
# CONTENT_MODEL writes every lesson, quiz and exercise (~165 calls, ~92% of spend).
OUTLINE_MODEL=gpt-4o-mini
CONTENT_MODEL=gpt-5-mini

# Only sent to models that accept it. gpt-5/gpt-6/o-series reason before answering
# and bill that thinking as output tokens, without it appearing in the content.
#
# The outline call only groups headings it is handed, so "low" costs nothing worth
# having there. CONTENT_REASONING is deliberately empty: leaving it unset lets the
# model think as much as it judges necessary, and capping that would be economising
# on the one call that is the product. Set it to low/medium/high to constrain it.
OUTLINE_REASONING=low
